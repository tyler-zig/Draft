# Browser-safe Supabase configuration. The publishable/anon key is protected by RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_SUPABASE_DATA_BUCKET=draft-data

# Server-only. Used by `npm run upload:supabase`; never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only. Used by the `grade-draft` edge function; never prefix this with VITE_.
# Set on the hosted project with `npx supabase secrets set DEEPSEEK_API_KEY=...`
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional. Defaults to deepseek-v4-flash. Set DEEPSEEK_THINKING=1 to enable reasoning.
# DEEPSEEK_MODEL=deepseek-v4-flash
# UTC cron expressions. Rankings default to every 6 hours; the live ADP board
# defaults to every 15 minutes; intelligence schedule / SOS refresh to twice daily.
RANKINGS_CRON_SCHEDULE=17 */6 * * *
ADP_CRON_SCHEDULE=*/15 * * * *
INTELLIGENCE_CRON_SCHEDULE=23 */12 * * *
